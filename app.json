{
  "expo": {
    "name": "Mayari",
    "slug": "mayari",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mayari",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A1E"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mayari.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A1E"
      },
      "package": "com.mayari.app",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A1E",
          "resizeMode": "contain"
        }
      ],
      "expo-web-browser",
      "@react-native-voice/voice",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#6366F1"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Mayari to use your location to find nearby gym buddies."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableJetifier": true
          }
        }
      ],
      "./plugins/withExcludeLegacySupportLib",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Mayari to use your microphone to log food by voice.",
          "speechRecognitionPermission": "Allow Mayari to recognize your speech to identify food items."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "04d2c3ec-0678-4d31-acbd-bfae3a8bed47"
      }
    }
  }
}
